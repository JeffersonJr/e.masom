{
  "rewrites": [
    { "source": "/api/auth/login", "destination": "/api/auth-login" },
    { "source": "/api/auth/signup", "destination": "/api/auth-signup" },
    { "source": "/api/auth/me", "destination": "/api/auth-me" },
    { "source": "/api/auth/forgot", "destination": "/api/auth-forgot" },
    { "source": "/api/auth/reset", "destination": "/api/auth-reset" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
